{
  "agent_route": "capabilities/llm/AGENTS.md",
  "configuration": {
    "additionalProperties": false,
    "description": "Optional output token bound; omitted values use the selected Provider policy.",
    "properties": {
      "max_tokens": {
        "description": "Positive output token limit",
        "minimum": 1,
        "provider_default": true,
        "type": "integer"
      }
    },
    "required": [],
    "type": "object"
  },
  "consumer": "cloud-skill",
  "description": {
    "en": "Text generation",
    "zh_CN": "文本生成"
  },
  "errors": {
    "invalid_input": "Skill rejects input before a billable request.",
    "provider_failure": "Nonzero Skill exit; retain valid partial/local results, report uncertain billing, do not automatically retry.",
    "unknown": "Environment, privacy decision, credentials or source version is unconfirmed.",
    "unsupported": "Operation or combination is not supported by the selected Skill."
  },
  "id": "llm",
  "limitations": [
    "Text only; no vision, tool execution or model listing.",
    "Incomplete streams are not successful results."
  ],
  "limits": {
    "automatic_retry": false,
    "roles": [
      "system",
      "user",
      "assistant"
    ],
    "stream_completion_required": true,
    "text_only": true
  },
  "operations": {
    "complete": {
      "input": {
        "additionalProperties": false,
        "description": "Select exactly one input file.",
        "oneRequired": [
          "prompt_file",
          "messages_file"
        ],
        "properties": {
          "messages_file": {
            "description": "JSON array of system/user/assistant text messages",
            "minLength": 1,
            "type": "string"
          },
          "prompt_file": {
            "description": "UTF-8 prompt file",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "description": "Non-streaming result.",
        "properties": {
          "text": {
            "description": "Generated text",
            "type": "string"
          },
          "usage": {
            "additionalProperties": true,
            "description": "Provider usage or null",
            "nullable": true,
            "properties": {},
            "required": [],
            "type": "object"
          }
        },
        "required": [
          "text",
          "usage"
        ],
        "type": "object"
      }
    },
    "stream": {
      "input": {
        "additionalProperties": false,
        "description": "Select exactly one input file.",
        "oneRequired": [
          "prompt_file",
          "messages_file"
        ],
        "properties": {
          "messages_file": {
            "description": "JSON array of system/user/assistant text messages",
            "minLength": 1,
            "type": "string"
          },
          "prompt_file": {
            "description": "UTF-8 prompt file",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output": {
        "description": "Incremental stdout text. A successful exit requires a complete stream; partial output with nonzero exit remains incomplete. The Provider owns its transport completion marker.",
        "type": "string"
      }
    }
  },
  "resources": {
    "memory_bytes": "Agent-host working memory; Provider bound unknown unless measured.",
    "storage_bytes": "Agent-host storage; Provider bound unknown unless measured."
  },
  "risk": {
    "automatic_retry": false,
    "billable": true,
    "device_write": false,
    "network": true,
    "secret_values_allowed": false
  },
  "schema_version": 2,
  "version": "2.0.0"
